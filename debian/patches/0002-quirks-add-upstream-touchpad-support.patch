diff --git a/quirks/30-vendor-hantick.quirks b/quirks/30-vendor-hantick.quirks
new file mode 100644
index 0000000..61d8a64
--- /dev/null
+++ b/quirks/30-vendor-hantick.quirks
@@ -0,0 +1,22 @@
+# Do not edit this file, it will be overwritten on update
+
+# HTIX3602:00 0911:5288 touchpad, clickpad pretending it has a right button.
+# Integrated into several systems, including
+# Purism Librem 14v1
+# Prestigio Smartbook 141 C2
+# StarLite Mk II
+# Iota IOTA2320
+# with different names
+# ALPS0001:00 0911:5288
+# HTIX3602:00 0911:5288
+# PCT2342:00 0911:5288
+# SP3105FT:00 0911:5288
+# SYNA3602:00 0911:5288
+# Also exist FTSC1000:00 0911:5288 Mouse, so match in type
+# is needed to leave mouse button untouched.
+[Hantick 0911:5288 Touchpad]
+MatchBus=i2c
+MatchVendor=0x0911
+MatchProduct=0x5288
+MatchUdevType=touchpad
+AttrEventCode=-BTN_RIGHT
diff --git a/quirks/30-vendor-microsoft.quirks b/quirks/30-vendor-microsoft.quirks
index 36efebb..c2c9c7b 100644
--- a/quirks/30-vendor-microsoft.quirks
+++ b/quirks/30-vendor-microsoft.quirks
@@ -38,3 +38,23 @@ MatchBus=usb
 MatchVendor=0x045E
 MatchProduct=0x0800
 ModelBouncingKeys=1
+
+# The Surface Pro 10 Flex keyboard touchpad is a clickpad that also
+# advertises a right button.
+[Microsoft Surface Pro 10 with Flex Keyboard Touchpad]
+MatchVendor=0x045E
+MatchProduct=0x0C8D
+MatchUdevType=touchpad
+AttrEventCode=-BTN_RIGHT
+
+# The same touchpad over Bluetooth when the keyboard is detached. udev tags it
+# external, which disables palm detection unless the touchpad sits below the
+# keys of a keyboard combo, as it does here. Like the attached touchpad it is a
+# clickpad that also advertises a right button.
+[Microsoft Surface Pro Flex Keyboard Touchpad (Bluetooth)]
+MatchBus=bluetooth
+MatchVendor=0x045E
+MatchProduct=0x0C7A
+MatchUdevType=touchpad
+AttrTPKComboLayout=below
+AttrEventCode=-BTN_RIGHT
