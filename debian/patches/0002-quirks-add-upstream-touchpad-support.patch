 MatchDMIModalias=dmi:*svnLENOVO:*pvrThinkBook16G8+IPH*:*
 MatchUdevType=touchpad
 ModelPressurePad=1
+
+# The touchpad firmware clears the confidence bit one frame before finger
+# lift-off, so hid-multitouch reports MT_TOOL_PALM at the end of every touch
+# and taps are always cancelled as palms.
+[Lenovo P14s Gen 6 Touchpad]
+MatchUdevType=touchpad
+MatchName=ELAN0676:00 04F3:3195 Touchpad
+MatchDMIModalias=dmi:*:svnLENOVO:*:pvrThinkPadP14sGen6:*
+AttrEventCode=-ABS_MT_TOOL_TYPE
